# ─────────────────────────────────────────────────────────────────────────────
#  Production .env for Python AI engine  →  copy to ~/GreenLedger-Main/greenledger-ai/ai-engine/.env
# ─────────────────────────────────────────────────────────────────────────────

LOCAL_MODE=false

# ── Local Ollama fallback (only used when LOCAL_MODE=true; not required on EC2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# ── S3 (same Cognizant STS creds as backend; or use IAM Role)
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=<ASIA…>
AWS_S3_SECRET_ACCESS_KEY=<secret>
AWS_S3_SESSION_TOKEN=<token>
S3_BUCKET_NAME=greenledger-documents-631772992059

# ── Bedrock (Cognizant) — model IDs MUST use the cross-region inference profile prefix
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY_ID=<ASIA…>
AWS_BEDROCK_SECRET_ACCESS_KEY=<secret>
AWS_BEDROCK_SESSION_TOKEN=<token>
BEDROCK_MODEL_HAIKU=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_SONNET=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ── Internal sync target (Node backend on the same box)
NODE_BACKEND_URL=http://localhost:5000

# ── SNS — ESG compliance alerts (create the topic in Cognizant account)
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:631772992059:greenledger-Alerts
AWS_SNS_REGION=us-east-1
AWS_SNS_ACCESS_KEY_ID=<ASIA…>
AWS_SNS_SECRET_ACCESS_KEY=<secret>
AWS_SNS_SESSION_TOKEN=<token>
GHG_ALERT_THRESHOLD_TCO2E=10000

# ── Frontend URL used in alert email links — same as Amplify domain in backend .env
FRONTEND_URL=https://main.<APP_ID>.amplifyapp.com
