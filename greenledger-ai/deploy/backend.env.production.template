# ─────────────────────────────────────────────────────────────────────────────
#  Production .env for Node.js backend  →  copy to ~/GreenLedger-Main/greenledger-ai/backend/.env
#  Replace every <ANGLE_BRACKET> placeholder.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
LOCAL_MODE=false
PORT=5000

# ── MongoDB Atlas — make sure 0.0.0.0/0 (or the EC2 elastic IP) is whitelisted
MONGO_URI=mongodb+srv://green-main:<ATLAS_PASSWORD>@cluster0.5ksebed.mongodb.net/?retryWrites=true&w=majority

# ── JWT (FRESH SECRET — generated from `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=465e6e8ceb6e2e1f018a21fe321cf41605dce177646de866ae029ae795aabfdb
JWT_EXPIRES_IN=7d

# ── AWS S3 (Cognizant account — STS creds expire, refresh every few hours, OR
#     attach an IAM Role to the EC2 instance and remove these three lines)
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=<ASIA…>
AWS_S3_SECRET_ACCESS_KEY=<secret>
AWS_S3_SESSION_TOKEN=<token>
S3_BUCKET_NAME=greenledger-documents-631772992059

# ── Redis Cloud — get this from https://app.redislabs.com/ → your DB → "Connect"
REDIS_URL=rediss://default:<REDIS_PASSWORD>@redis-XXXXX.c1.us-east-1-1.ec2.redns.redis-cloud.com:18745

# ── Internal: the AI engine bound to localhost on the same EC2 box
AI_ENGINE_URL=http://localhost:8000

# ── CORS allow-list — fill in AFTER Amplify deploys (gives you the exact domain).
#     Comma-separated; keep localhost entries for SSH-tunnel debugging.
FRONTEND_URL=https://main.<APP_ID>.amplifyapp.com,http://localhost:3000,http://localhost:5173
